{
  "manifest_version": 3,
  "name": "Verbal — dual-stream capture",
  "version": "1.0.5",
  "description": "Captures microphone and meeting tab audio separately and streams both to the Kobayashi desktop app.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Start capturing this tab",
    "default_icon": {
      "16": "res/verbal-16.png",
      "32": "res/verbal-32.png",
      "48": "res/verbal-48.png",
      "128": "res/verbal-128.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "res/verbal-16.png",
    "32": "res/verbal-32.png",
    "48": "res/verbal-48.png",
    "128": "res/verbal-128.png"
  }
}
